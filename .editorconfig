# Shared editor settings for Windows and macOS.
# JetBrains IDEs read this natively. VS Code needs the "EditorConfig for VS Code" extension.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: two trailing spaces are a hard line break, so keep them
[*.md]
trim_trailing_whitespace = false

# Windows-only scripts must stay CRLF
[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab