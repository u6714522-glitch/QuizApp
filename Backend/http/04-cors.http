### Unknown origin is not allowed
# @no-cookie-jar
GET {{host}}/api/me
Origin: http://evil.example

> {%
  client.test("Allow-Origin does not echo a foreign origin", () => {
    const origin = response.headers.valueOf("Access-Control-Allow-Origin");
    client.assert(origin !== "http://evil.example" && origin !== "*", `Allow-Origin was ${origin}`);
  });
%}

