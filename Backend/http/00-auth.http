# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "broken",

> {% client.test("400", () => client.assert(response.status === 400, `got ${response.status}`)); %}

### Login wrong password -> 401
# @no-cookie-jar
POST {{host}}/api/authentication/login
Content-Type: application/json

{ "email": "{{studentEmail}}", "password": "WrongPassword123" }

> {%
  client.test("401", () => client.assert(response.status === 401, `got ${response.status}`));
  client.global.set("wrongPwMsg", response.body.error?.message ?? "");
%}

### Login unknown email -> 401 with the SAME message (no user enumeration)
# @no-cookie-jar
POST {{host}}/api/authentication/login
Content-Type: application/json

{ "email": "nobody-{{$uuid}}@quizdeck.test", "password": "{{password}}" }

> {%
  client.test("401, same message as wrong password", () => {
    client.assert(response.status === 401, `got ${response.status}`);
    client.assert(response.body.error?.message === client.global.get("wrongPwMsg"), "messages differ");
  });
%}

### Login instructor
# @no-cookie-jar
POST {{host}}/api/authentication/login
Content-Type: application/json

{ "email": "{{instructorEmail}}", "password": "{{password}}" }

> {%
  client.test("200, httpOnly cookie, role instructor", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const sc = response.headers.valueOf("Set-Cookie") ?? "";
    client.assert(/qd_session=/.test(sc) && /HttpOnly/i.test(sc), `bad Set-Cookie: ${sc}`);
    const u = response.body.user ?? response.body;
    client.assert(u.role === "instructor", "not promoted — run the mongosh command in this file");
    client.assert(!JSON.stringify(response.body).includes("password"), "leaks password hash");
    client.global.set("instructorToken", /qd_session=([^;]+)/.exec(sc)[1]);
  });
%}

### Login student
# @no-cookie-jar
POST {{host}}/api/authentication/login
Content-Type: application/json

{ "email": "{{studentEmail}}", "password": "{{password}}" }

> {%
  client.test("200 and cookie", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const sc = response.headers.valueOf("Set-Cookie") ?? "";
    client.global.set("studentToken", /qd_session=([^;]+)/.exec(sc)[1]);
  });
%}

### Me without cookie -> 401
# @no-cookie-jar
GET {{host}}/api/me

> {%
  client.test("401 with error envelope", () => {
    client.assert(response.status === 401, `got ${response.status}`);
    client.assert(response.body.error?.code, "missing error.code");
  });
%}

### Me with garbage cookie -> 401
# @no-cookie-jar
GET {{host}}/api/me
Cookie: qd_session=not.a.jwt

> {% client.test("401", () => client.assert(response.status === 401, `got ${response.status}`)); %}

### Me as instructor
# @no-cookie-jar
GET {{host}}/api/me
Cookie: qd_session={{instructorToken}}

> {%
  client.test("200, instructor", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const u = response.body.user ?? response.body;
    client.assert(u.role === "instructor", `role ${u.role}`);
    client.assert(!JSON.stringify(response.body).includes("password"), "leaks password hash");
    client.global.set("instructorId", u.id);
  });
%}

### Me as student
# @no-cookie-jar
GET {{host}}/api/me
Cookie: qd_session={{studentToken}}

> {%
  client.test("200, student", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const u = response.body.user ?? response.body;
    client.assert(u.role === "student", `role ${u.role}`);
    client.global.set("studentId", u.id);
  });
%}

### Logout clears the cookie
# @no-cookie-jar
POST {{host}}/api/authentication/logout
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 and cookie expired", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const sc = response.headers.valueOf("Set-Cookie") ?? "";
    client.assert(/qd_session=/.test(sc) && /(Max-Age=0|Expires=Thu, 01 Jan 1970)/i.test(sc), `not cleared: ${sc}`);
  });
%}

### Logout without a session still works
# @no-cookie-jar
POST {{host}}/api/authentication/logout

> {% client.test("200", () => client.assert(response.status === 200, `got ${response.status}`)); %}
