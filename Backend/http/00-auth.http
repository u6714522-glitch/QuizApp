### Register instructor (then promote by hand — see note below)
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Test Instructor", "email": "{{instructorEmail}}", "password": "{{password}}" }

> {%
  client.test("201 new or 409 already registered", () => {
    client.assert([201, 409].includes(response.status), `got ${response.status}`);
  });
  if (response.status === 201) client.test("no password in response", () => {
    client.assert(!JSON.stringify(response.body).includes("password"), "leaks password/passwordHash");
  });
%}


### Register student
# One-time promote (register never accepts a role):
# mongosh quizdeck --eval 'db.users.updateOne({email:"instructor@quizdeck.test"},{$set:{role:"instructor"},$inc:{tokenVersion:1}})'
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Test Student", "email": "{{studentEmail}}", "password": "{{password}}" }

> {%
  client.test("201 new or 409 already registered", () => {
    client.assert([201, 409].includes(response.status), `got ${response.status}`);
  });
%}

### Register ignores a client-supplied role
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Sneaky", "email": "sneaky-{{$uuid}}@quizdeck.test", "password": "{{password}}", "role": "instructor" }

> {%
  client.test("201 and role forced to student (or role rejected with 400)", () => {
    if (response.status === 400) return;
    client.assert(response.status === 201, `got ${response.status}`);
    const u = response.body.user ?? response.body;
    client.assert(u.role === "student", `role was ${u.role}`);
  });
%}

### Register duplicate email -> 409
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Dup", "email": "{{studentEmail}}", "password": "{{password}}" }

> {%
  client.test("409 EMAIL_TAKEN", () => {
    client.assert(response.status === 409, `got ${response.status} — is the unique index on users.email created?`);
    client.assert(response.body.error?.code, "missing error.code");
  });
%}

### Register missing name -> 400
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "email": "noname-{{$uuid}}@quizdeck.test", "password": "{{password}}" }

> {%
  client.test("400 with error envelope", () => {
    client.assert(response.status === 400, `got ${response.status}`);
    client.assert(response.body.error?.code && response.body.error?.message, "missing error.code/message");
  });
%}

### Register short password -> 400
# @no-cookie-jar
POST {{host}}/api/authentication/register
Content-Type: application/json

{ "name": "Short", "email": "short-{{$uuid}}@quizdeck.test", "password": "abc" }

> {% client.test("400", () => client.assert(response.status === 400, `got ${response.status}`)); %}

