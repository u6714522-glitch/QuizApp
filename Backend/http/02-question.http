### Add multiple-choice question (2 pts)
# @no-cookie-jar
POST {{host}}/api/question?quizId={{quizId}}
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{
  "type": "multiple_choice",
  "prompt": "What is 2 + 2?",
  "choices": [{ "key": "a", "text": "3" }, { "key": "b", "text": "4" }, { "key": "c", "text": "5" }],
  "correctAnswer": "b",
  "points": 2,
  "explanation": "2 + 2 = 4"
}

> {%
  client.test("201, order 1, quizId set", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    const q = response.body.question ?? response.body;
    client.assert(q.id && q.quizId === client.global.get("quizId") && q.order === 1, JSON.stringify(q));
    client.global.set("qMcId", q.id);
  });
%}

### Add true/false question (1 pt)
# @no-cookie-jar
POST {{host}}/api/question?quizId={{quizId}}
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "type": "true_false", "prompt": "MongoDB is a relational database.", "correctAnswer": "false", "explanation": "It is a document database." }

> {%
  client.test("201, order auto-incremented, points default 1", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    const q = response.body.question ?? response.body;
    client.assert(q.order === 2 && q.points === 1, JSON.stringify(q));
    client.global.set("qTfId", q.id);
  });
%}

### Add short-answer question (1 pt)
# @no-cookie-jar
POST {{host}}/api/question?quizId={{quizId}}
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "type": "short_answer", "prompt": "Capital of Australia?", "correctAnswer": "Canberra", "explanation": "Not Sydney." }

> {%
  client.test("201", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    client.global.set("qSaId", (response.body.question ?? response.body).id);
  });
%}

