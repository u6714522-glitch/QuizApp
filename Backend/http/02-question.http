### List questions as owner -> sorted, answers visible
# @no-cookie-jar
GET {{host}}/api/question?quizId={{quizId}}
Cookie: qd_session={{instructorToken}}

> {%
  client.test("200, 4 questions in order, owner sees correctAnswer", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const list = response.body.questions ?? response.body;
    client.assert(list.length === 4, `got ${list.length}`);
    client.assert(list.every((q, i) => i === 0 || list[i - 1].order <= q.order), "not sorted by order");
    client.assert(list.every((q) => q.correctAnswer !== undefined), "owner should see answers");
  });
%}

