### Get one question as owner
# @no-cookie-jar
GET {{host}}/api/question/{{qMcId}}
Cookie: qd_session={{instructorToken}}

> {%
  client.test("200 with correctAnswer", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const q = response.body.question ?? response.body;
    client.assert(q.id === client.global.get("qMcId") && q.correctAnswer === "b", JSON.stringify(q));
  });
%}

