### Update question prompt -> 200
# @no-cookie-jar
PUT {{host}}/api/question/{{qMcId}}
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "prompt": "What is 2 + 2? (edited)" }

> {%
  client.test("200 and prompt changed, other fields kept", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const q = response.body.question ?? response.body;
    client.assert(q.prompt.endsWith("(edited)") && q.correctAnswer === "b" && q.points === 2, JSON.stringify(q));
  });
%}

