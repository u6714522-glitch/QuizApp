### Update title as owner -> 200
# @no-cookie-jar
PUT {{host}}/api/quiz/{{quizId}}
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "title": "HTTP Test Quiz (edited)", "passingScore": 60 }

> {%
  client.test("200 and title changed", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const q = response.body.quiz ?? response.body;
    client.assert(q.title === "HTTP Test Quiz (edited)" && q.passingScore === 60, "not updated");
  });
%}

