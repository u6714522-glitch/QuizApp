> {% client.test("404", () => client.assert(response.status === 404, `got ${response.status}`)); %}

### Start attempt as student -> 201
# @no-cookie-jar
POST {{host}}/api/attempt
Cookie: qd_session={{studentToken}}
Content-Type: application/json

{ "quizId": "{{quizId}}" }

> {%
  client.test("201 in_progress, maxScore 4", () => {
    client.assert(response.status === 201, `got ${response.status}`);
    const a = response.body.attempt ?? response.body;
    client.assert(a.status === "in_progress" && a.maxScore === 4 && a.score == null, JSON.stringify(a));
    client.assert(a.studentId === client.global.get("studentId"), "studentId is not the caller");
    client.global.set("attemptId", a.id);
  });
%}

### Start a second attempt while one is in progress -> 409
# @no-cookie-jar
POST {{host}}/api/attempt
Cookie: qd_session={{studentToken}}
Content-Type: application/json

{ "quizId": "{{quizId}}" }

> {% client.test("409", () => client.assert(response.status === 409, `got ${response.status}`)); %}

### Save answers -> 200, still in progress, not graded
# @no-cookie-jar
PUT {{host}}/api/attempt/{{attemptId}}
Cookie: qd_session={{studentToken}}
Content-Type: application/json

{
  "action": "save",
  "answers": [
    { "questionId": "{{qMcId}}", "given": "b" },
    { "questionId": "{{qTfId}}", "given": "true" }
  ]
}

> {%
  client.test("200, in_progress, no grading leaked", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const a = response.body.attempt ?? response.body;
    client.assert(a.status === "in_progress", a.status);
    client.assert(a.answers.length === 2 && a.answers.every((x) => x.given !== undefined), "answers not stored as `given`");
    client.assert(a.answers.every((x) => x.isCorrect == null), "isCorrect leaked before submit");
  });
%}

### Save answer for a question not in this quiz -> 400
# @no-cookie-jar
PUT {{host}}/api/attempt/{{attemptId}}
Cookie: qd_session={{studentToken}}
Content-Type: application/json

{ "action": "save", "answers": [{ "questionId": "{{missingId}}", "given": "a" }] }

> {% client.test("400", () => client.assert(response.status === 400, `got ${response.status}`)); %}

