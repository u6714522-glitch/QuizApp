### Publish the quiz (has questions now)
# @no-cookie-jar
PUT {{host}}/api/quiz/{{quizId}}
Cookie: qd_session={{instructorToken}}
Content-Type: application/json

{ "status": "published" }

> {%
  client.test("200 published", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert((response.body.quiz ?? response.body).status === "published", "not published");
  });
%}

### Student reads quiz for attempt -> no answers, no explanations
# @no-cookie-jar
GET {{host}}/api/quiz/{{quizId}}?for=attempt
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 and nothing leaked", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const qs = response.body.questions;
    client.assert(qs.length === 3, `got ${qs.length}`);
    client.assert(qs.every((q) => q.correctAnswer === undefined), "correctAnswer leaked");
    client.assert(qs.every((q) => q.explanation === undefined), "explanation leaked before grading");
  });
%}






### Student lists questions -> no answers
# @no-cookie-jar
GET {{host}}/api/question?quizId={{quizId}}
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 and no correctAnswer", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const list = response.body.questions ?? response.body;
    client.assert(list.every((q) => q.correctAnswer === undefined), "correctAnswer leaked");
  });
%}

### Student reads one question -> no answer
# @no-cookie-jar
GET {{host}}/api/question/{{qMcId}}
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 and no correctAnswer", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    client.assert((response.body.question ?? response.body).correctAnswer === undefined, "correctAnswer leaked");
  });
%}

