> {% client.test("403", () => client.assert(response.status === 403, `got ${response.status}`)); %}

### Quiz owner can read the attempt
# @no-cookie-jar
GET {{host}}/api/attempt/{{attemptId}}
Cookie: qd_session={{instructorToken}}

> {% client.test("200", () => client.assert(response.status === 200, `got ${response.status}`)); %}

### Submit (adds short answer, messy casing) -> graded 3/4
# @no-cookie-jar
PUT {{host}}/api/attempt/{{attemptId}}
Cookie: qd_session={{studentToken}}
Content-Type: application/json

{ "action": "submit", "answers": [{ "questionId": "{{qSaId}}", "given": "  canberra " }] }

> {%
  client.test("200, graded, score 3 of 4", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const a = response.body.attempt ?? response.body;
    client.assert(a.status === "graded", a.status);
    client.assert(a.score === 3 && a.maxScore === 4, `score ${a.score}/${a.maxScore}`);
    client.assert(a.submittedAt, "submittedAt missing");
    const byQ = Object.fromEntries(a.answers.map((x) => [x.questionId, x]));
    client.assert(byQ[client.global.get("qMcId")].pointsAwarded === 2, "MC should earn 2");
    client.assert(byQ[client.global.get("qTfId")].isCorrect === false, "TF should be wrong");
    client.assert(byQ[client.global.get("qSaId")].isCorrect === true, "SA should be right (trim + case-insensitive)");
  });
%}

### Result view shows explanations after grading
# @no-cookie-jar
GET {{host}}/api/attempt/{{attemptId}}
Cookie: qd_session={{studentToken}}

> {%
  client.test("200 with questions + explanations", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const qs = response.body.questions ?? [];
    client.assert(qs.length === 3 && qs.every((q) => q.explanation !== undefined), "explanations missing");
  });
%}

### Save after submit -> 409
# @no-cookie-jar
PUT {{host}}/api/attempt/{{attemptId}}
Cookie: qd_session={{studentToken}}
Content-Type: application/json

{ "action": "save", "answers": [] }

> {% client.test("409", () => client.assert(response.status === 409, `got ${response.status}`)); %}

### Student lists own attempts
# @no-cookie-jar
GET {{host}}/api/attempt
Cookie: qd_session={{studentToken}}

> {%
  client.test("200, contains attempt, only own", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const b = response.body;
    const list = Array.isArray(b) ? b : (b.attempts ?? b.items ?? b.data ?? []);
    client.assert(list.some((a) => a.id === client.global.get("attemptId")), "attempt missing");
    client.assert(list.every((a) => a.studentId === client.global.get("studentId")), "other students' attempts leaked");
  });
%}

### Instructor lists attempts on own quiz (results page)
# @no-cookie-jar
GET {{host}}/api/attempt?quizId={{quizId}}
Cookie: qd_session={{instructorToken}}

> {%
  client.test("200, contains attempt with student name", () => {
    client.assert(response.status === 200, `got ${response.status}`);
    const b = response.body;
    const list = Array.isArray(b) ? b : (b.attempts ?? b.items ?? b.data ?? []);
    const a = list.find((x) => x.id === client.global.get("attemptId"));
    client.assert(a && a.student?.name, "attempt or student.name missing");
  });
%}

